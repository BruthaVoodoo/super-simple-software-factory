# SSSF starter recipes. Stamped by install.py, then yours to edit.
#
# Canonical product recipe set (M1). Includes everything the historical
# example branch stamped (minus `cc`/`ipi` — the factory is Pi-only and
# /sssf is an optional frontend), plus `demo` and `smoke-real-pi`.
#
# `.env` reaches every ADW through this, so keys work without exporting them.
set dotenv-load
set positional-arguments

# Every recipe passes the roster through SSSF_CONFIG, so
# `SSSF_CONFIG=other.yaml just sdlc "..."` swaps the whole roster for one run.
config := env_var_or_default("SSSF_CONFIG", "adws/adw_sssf_config/sssf.config.yaml")
export SSSF_CONFIG := config

# Trace db location, as configured (both recipes below read it via manage.py).
db     := "adws/adw_data/sssf.db"

# list every recipe
default:
    @just --list

# ── first run ───────────────────────────────────────────────────────────────

# Proves the whole path works: config validated, session minted, agent ran,
# envelope parsed, gates checked, trace written. Costs a few cents and changes
# nothing in your repo, because both workflows are read-only.

# start here: two cheap read-only runs, end to end
demo:
    @echo "1/2  adw_prompt: one agent, one prompt"
    uv run adws/adw_prompt.py --config "$SSSF_CONFIG" --agent scout "reply with a one-line summary of this repo"
    @echo "\n2/2  adw_scout: read-only recon"
    uv run adws/adw_scout.py --config "$SSSF_CONFIG" "list the top-level directories in this repo and what each is for. change nothing."
    @echo "\nboth done. now run:  just sessions    (or: just obs)"

# ── orchestrator (boot pi ON the factory) ──────────────────────────────────

# Pi orchestrator — reads the sssf skill, then handles your ask
pi:
    pi "Read and Execute .claude/skills/sssf/SKILL.md"

# ── run a workflow ──────────────────────────────────────────────────────────
# Args pass straight through: "<prompt or path/to/prompt.md>" [--adw-id X]

# one agent, one prompt: just prompt "summarize this repo"
prompt *ARGS:
    uv run adws/adw_prompt.py --config "$SSSF_CONFIG" "$@"

# pick the agent by name: just ask scout "where does auth live"
ask AGENT *ARGS:
    agent="$1"; shift; uv run adws/adw_prompt.py --config "$SSSF_CONFIG" --agent "$agent" "$@"

# read-only recon: just scout "where is auth handled"
scout *ARGS:
    uv run adws/adw_scout.py --config "$SSSF_CONFIG" "$@"

# plan only: just plan "add a /health endpoint"
plan *ARGS:
    uv run adws/adw_plan.py --config "$SSSF_CONFIG" "$@"

# planner, builder, commit: just plan-build "add a /health endpoint"
plan-build *ARGS:
    uv run adws/adw_plan_build.py --config "$SSSF_CONFIG" "$@"

# builder, deterministic test, bounded fix loop: just build-test "..."
build-test *ARGS:
    uv run adws/adw_build_test.py --config "$SSSF_CONFIG" "$@"

# builder, reviewer, bounded revise loop: just build-review "..."
build-review *ARGS:
    uv run adws/adw_build_review.py --config "$SSSF_CONFIG" "$@"

# write up the work just done, from git diff: just document "..."
document *ARGS:
    uv run adws/adw_document.py --config "$SSSF_CONFIG" "$@"

# plan, build, test, commit: just sdlc "add a /health endpoint"
sdlc *ARGS:
    uv run adws/adw_plan_build_test.py --config "$SSSF_CONFIG" "$@"

# the full chain, plus review and docs: just simple-sdlc "add a /health endpoint"
simple-sdlc *ARGS:
    uv run adws/adw_simple_sdlc.py --config "$SSSF_CONFIG" "$@"

# bounded real-Pi smoke: probe + recall, trace-verified. Real tokens, can fail.
# Deliberately never a test double; the launcher refuses fakes.
smoke-real-pi *ARGS:
    uv run adws/adw_smoke.py --config "$SSSF_CONFIG" "$@"

# ── inspect ─────────────────────────────────────────────────────────────────
# All inspection routes through adws/manage.py: readonly connections,
# parameterized queries, deterministic JSON. Reads never block a running
# workflow, the db is WAL.

# which rosters exist and who is in them
rosters:
    uv run adws/manage.py --config "$SSSF_CONFIG" rosters

# the last 10 runs
sessions:
    uv run adws/manage.py --config "$SSSF_CONFIG" sessions

# phase status in sequence: just phases <adw_id>
phases ADW_ID:
    uv run adws/manage.py --config "$SSSF_CONFIG" phases --adw-id="$1"

# the live event tail: just tail <adw_id>
tail ADW_ID:
    uv run adws/manage.py --config "$SSSF_CONFIG" tail --adw-id="$1"

# what a run has alive right now, with pids: just procs <adw_id>
procs ADW_ID:
    uv run adws/manage.py --config "$SSSF_CONFIG" procs --adw-id="$1"

# stop a stuck run — verified identities only, confirmation required:
# just kill <adw_id>
kill ADW_ID:
    uv run adws/manage.py --config "$SSSF_CONFIG" kill --adw-id="$1"

# ── observability UI ────────────────────────────────────────────────────────

# Needs bun. The db path is passed explicitly because the server runs from the
# app dir and would otherwise look for a trace db sitting next to itself.

# boot the trace UI, http://localhost:4601 (api on :4600)
obs:
    cd .claude/skills/sssf/apps/visualizer && bun install && (SSSF_DB={{justfile_directory()}}/{{db}} bun run server/index.ts &) && bunx vite
